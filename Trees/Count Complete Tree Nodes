class Solution {
  public:
    int leftHeight(Node* root){
        Node* temp = root;
        int lh = 0;
        while(temp!= NULL){
            temp = temp->left;
            lh++;
        }
        return lh;
        
    }
    int rightHeight(Node* root){
        Node* temp = root;
        int rh = 0;
        while(temp!= NULL){
            temp = temp->right;
            rh++;
        }
        return rh;
        
    }
    int countNodes(Node* root) {
        if(root == NULL)
          return 0;
        int lh = leftHeight(root);
        int rh = rightHeight(root);
        
        if(lh == rh)
         return pow(2,lh) -1;
         
        return countNodes(root->left)+countNodes(root->right) +1;
    }
};
