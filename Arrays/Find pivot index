class Solution {
public:
    int pivotIndex(vector<int>& nums) {
        int total_sum = 0;
        int n = nums.size();
        for(int i =0;i<n;i++){
            total_sum += nums[i]; //total sum of array
        }
        int left_Sum = 0; //left sum
        for (int i = 0; i < nums.size(); i++) {
            int right_Sum = total_sum - left_Sum - nums[i]; //find the right sum
            if (left_Sum == right_Sum)
                return i;   

            left_Sum += nums[i]; //update the left sum 
        }

        return -1;
        
        
    }
};
