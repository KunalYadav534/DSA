class Solution {
public:
    int totalFruit(vector<int>& fruits) {
        int n = fruits.size();
        int i =0,j=0;
        int count = 0;
        unordered_map<int,int> map;
        while(j<n){
            map[fruits[j]]++;

            if(map.size() <=2){
                count = max(count,j-i+1);

            }
            else{
                map[fruits[i]]--;
                if(map[fruits[i]] == 0){
                    map.erase(fruits[i]);
                }
                i++;
            }
            j++;
        }
        return count;
        
    }

};
