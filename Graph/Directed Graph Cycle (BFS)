class Solution {
  public:
    bool isCyclic(int N, vector<vector<int>> &edges) {
        // code here
        
        vector<int> adj[N];
        for(auto &e:edges){
            adj[e[0]].push_back(e[1]);
        }
        queue<int> que;
        vector<int> indegree(N,0);
        for(int u = 0;u<N;u++){
            for(int &v :adj[u]){
                indegree[v]++;
            }
        }
        int count = 0;
        for(int i = 0;i<N;i++){
            if(indegree[i] == 0){
                que.push(i);
                count++;
            }
        }
        
        
        while(!que.empty()){
            int u = que.front();
            que.pop();
            for(int &v :adj[u]){
                indegree[v]--;
                
            if(indegree[v] == 0){
              que.push(v);
              count++;
            }
            }
        }
        
        if(count == N){ //we visited all the nodes
            return false;
        }
        return true;  // has cycle
    }
};
